#!/bin/sh
# The environment of the release (docs/server-artifact.md).

# No Erlang distribution, so the server opens no port and starts no port
# mapper.
export RELEASE_DISTRIBUTION=none

# No crash dump. A dump holds the heap of every process, the TypeDB
# connection's password among them, and would be written to whatever directory
# the server was started in. SIGUSR1, running out of memory and a halt all
# write one unless this is 0.
export ERL_CRASH_DUMP_SECONDS=0

# The resolver's configuration (rel/overlays/inetrc): a domain, so that the VM
# does not look its own host name up at boot.
export ERL_INETRC="$RELEASE_ROOT/inetrc"
