#!/bin/sh
# SPDX-FileCopyrightText: 2026 NoeticEcho and the reminisce contributors
# SPDX-License-Identifier: Apache-2.0
#
# Installs the reminisce server this plugin starts: downloads the tarball
# for this plugin's version and this machine from the version's GitHub
# release, checks its SHA-256, and unpacks it into the plugin's server/
# directory, where bin/reminisce-mcp starts it. Nothing that does not match
# the checksum is unpacked.
#
# The checksum is, first that wins:
#   - the one given with --sha256;
#   - the one this plugin pins in server.sha256, beside this directory;
#   - the one in the release's own .sha256 file, downloaded beside the
#     tarball. That one finds a damaged download, not a release whose files
#     were replaced; the script says so when it uses it.
#
# It runs only when the user runs it (the plugin's setup step); nothing in
# the plugin runs it at session start. Running it again installs the same
# files again.
#
#   install-server                       download from the release
#   install-server --file TARBALL        install a tarball that is already here
#   install-server --sha256 HEX          check against HEX
#
# The downloads are its only network calls: HTTPS GETs from github.com, and
# from the host that GitHub redirects a release file to.

set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
release=https://github.com/NoeticEcho/reminisce-elixir/releases/download

say() { printf 'install-server: %s\n' "$*" >&2; }
fail() {
  say "$*"
  exit 1
}

file=
sha=
while [ $# -gt 0 ]; do
  case $1 in
  --file | --sha256)
    [ $# -ge 2 ] || fail "$1 needs a value"
    if [ "$1" = --file ]; then file=$2; else sha=$2; fi
    shift 2
    ;;
  *) fail "unknown argument: $1 (see the comment at the top of $0)" ;;
  esac
done

version=$(sed -n 's/^  "version": "\([^"]*\)",$/\1/p' "$root/.claude-plugin/plugin.json")
[ -n "$version" ] || fail "no version in $root/.claude-plugin/plugin.json"

case $(uname -s) in
Linux) os=linux ;;
Darwin) os=macos ;;
*) fail "this system is $(uname -s); the server runs on Linux and macOS only" ;;
esac

case $(uname -m) in
x86_64 | amd64) arch=x86_64 ;;
aarch64 | arm64) arch=arm64 ;;
*) fail "this machine is $(uname -m); the server runs on x86_64 and arm64 only" ;;
esac

name=reminisce-mcp-$version-$os-$arch
tarball=$name.tar.gz

if [ -z "$sha" ]; then
  sha=$(awk -v name="$tarball" '$1 !~ /^#/ && $2 == name { print $1 }' "$root/server.sha256")
fi

if command -v sha256sum >/dev/null 2>&1; then
  sha256() { sha256sum "$1" | cut -d' ' -f1; }
elif command -v shasum >/dev/null 2>&1; then
  sha256() { shasum -a 256 "$1" | cut -d' ' -f1; }
else
  fail "neither sha256sum nor shasum is installed, so the server cannot be checked"
fi

check_sha() {
  case $sha in
  *[!0-9a-f]* | '') fail "not a SHA-256 in lower-case hex: $sha" ;;
  esac
  [ ${#sha} -eq 64 ] || fail "not a SHA-256 in lower-case hex: $sha"
}
[ -z "$sha" ] || check_sha

work=$(mktemp -d "$root/.install-server.XXXXXX")
trap 'rm -rf "$work"' EXIT
trap 'exit 1' HUP INT TERM

if [ -n "$file" ]; then
  [ -n "$sha" ] ||
    fail "this plugin pins no checksum for $tarball in $root/server.sha256: give the tarball's with --sha256. Nothing was installed."
  [ -f "$file" ] || fail "no file at $file"
  cp "$file" "$work/$tarball"
else
  command -v curl >/dev/null 2>&1 || fail "curl is not installed; it is needed to download the server"
  url=$release/v$version/$tarball
  get() { curl -fsSL --proto '=https' --tlsv1.2 -o "$1" "$2"; }

  if [ -z "$sha" ]; then
    # A version's plugin is published before its release's tarballs exist,
    # so it may pin none: the release's own checksum file is then the check.
    say "this plugin pins no checksum for $tarball: checking it against $url.sha256, which finds a damaged download, not a release whose files were replaced"
    get "$work/$tarball.sha256" "$url.sha256" ||
      fail "the download of $url.sha256 failed; its reason is above. Nothing was installed."
    sha=$(awk -v name="$tarball" '$2 == name { print $1 }' "$work/$tarball.sha256")
    check_sha
  fi

  say "downloading $url"
  get "$work/$tarball" "$url" ||
    fail "the download of $url failed; its reason is above. Nothing was installed."
fi

actual=$(sha256 "$work/$tarball")
[ "$actual" = "$sha" ] ||
  fail "$tarball has the SHA-256 $actual, not $sha: it is not the release's file. Nothing was installed."

mkdir "$work/unpacked"
tar -xzf "$work/$tarball" -C "$work/unpacked"
[ -x "$work/unpacked/$name/bin/reminisce-mcp" ] ||
  fail "$tarball does not hold $name/bin/reminisce-mcp. Nothing was installed."

# The new server takes the old one's place in two renames.
rm -rf "$root/server.old"
if [ -e "$root/server" ]; then mv "$root/server" "$root/server.old"; fi
mv "$work/unpacked/$name" "$root/server"
rm -rf "$root/server.old"

say "installed reminisce-mcp $version for $os $arch in $root/server"
